# App
APP_ENV=dev
ALLOWED_ORIGINS=*
ROOT_PATH=

# Auth
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRY_MINUTES=10
REFRESH_TOKEN_EXPIRY_DAYS=7
DEFAULT_ADMIN_PASSWORD=admin123

# Uploads
MAX_UPLOAD_MB=50

# Bulk uploads (multi-file / zip setup ingestion)
MAX_BULK_FILES=100
MAX_BULK_FILE_MB=10
MAX_ZIP_ENTRIES=200
MAX_BULK_DECOMPRESSED_MB=200
MAX_COMPRESSION_RATIO=200

# Audit
AUDIT_MAX_BODY_BYTES=10000

# Survey
PRICE_ALERT_THRESHOLD_PCT=50

# Reports
# Prod: set to an absolute path OUTSIDE the repo checkout (e.g. a mounted
# volume) so redeploys / git operations never touch generated report files.
REPORTS_DIR=generated_reports
# Host-side bind path for `docker compose up` only — independent of
# REPORTS_DIR above (which is what the app reads directly; inside the
# container it's always pinned to /app/generated_reports to match the
# mount). Defaults to ./generated_reports if unset. Set to an absolute
# path to make reports browsable at a fixed location on your machine.
# REPORTS_HOST_DIR=
REPORT_WARN_ROWS=5000
REPORT_MAX_ROWS=20000
REPORT_MAX_ROWS_XLSX=100000
REPORT_MAX_CONCURRENT_RENDERS=1

# Rate Limiting
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=120/minute

# Logging
LOG_DIR=logs
# Host-side bind path for `docker compose up` only, independent of LOG_DIR
# above (same pattern as REPORTS_HOST_DIR). Defaults to ./logs if unset.
# LOGS_HOST_DIR=
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=DEBUG

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tripura_cpi

# pgAdmin (only used with: docker compose --profile local-db up)
PGADMIN_EMAIL=admin@tripura-cpi.local
PGADMIN_PASSWORD=admin
